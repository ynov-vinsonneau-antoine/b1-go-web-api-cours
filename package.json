{
  "name": "cours-groupie-tracker-b1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:1": "slidev diapo-1.md --open",
    "dev:2": "slidev diapo-2.md --open",
    "dev:3": "slidev diapo-3.md --open",
    "build:1": "slidev build diapo-1.md --out dist/diapo-1",
    "build:2": "slidev build diapo-2.md --out dist/diapo-2",
    "build:3": "slidev build diapo-3.md --out dist/diapo-3",
    "check:1": "npm run build:1 && node check-layout.cjs dist/diapo-1",
    "check:2": "npm run build:2 && node check-layout.cjs dist/diapo-2",
    "check:3": "npm run build:3 && node check-layout.cjs dist/diapo-3",
    "export:1": "slidev export diapo-1.md --per-slide --wait-until networkidle --wait 1500",
    "export:2": "slidev export diapo-2.md --per-slide --wait-until networkidle --wait 1500",
    "export:3": "slidev export diapo-3.md --per-slide --wait-until networkidle --wait 1500"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.62.1"
  }
}
